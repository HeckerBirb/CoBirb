{
  "default_model": "llama3.1",
  "models": {
    "default": {
      "name": "llama3.1",
      "base_url": "http://localhost:11434"
    }
  },
  "persona": "none",
  "system_prompt": "off",
  "plugins": {
    "model": "core-model",
    "io": "core-io",
    "crypto": "core-crypto"
  },
  "allow_tools": [],
  "allow_read_dirs": [],
  "allow_write_dirs": [],
  "redact_secrets": true,
  "checkpoints": true,
  "instructions": true,
  "instructions_max_chars": 2000,
  "context_tokens": null,
  "plan_mode": false,
  "audit_log": false
}
