{
  "default_model": "llama3.1",

  "//models": "One model per role. Every role inherits from 'default', so a role that names only a model still gets the default's endpoint. 'worker' is reserved for subagents (v0.5.0) and has no caller yet. Run 'cobirb models' to see how yours resolve.",
  "models": {
    "default": {
      "name": "llama3.1",
      "base_url": "http://localhost:11434"
    },
    "orchestrator": {
      "name": "llama3.1"
    },
    "worker": {
      "name": "llama3.1"
    }
  },

  "persona": "none",
  "system_prompt": "off",
  "plugins": {
    "model": "core-model",
    "io": "core-io",
    "crypto": "core-crypto"
  },
  "allow_tools": [],
  "allow_read_dirs": [],
  "allow_write_dirs": [],
  "verify_command": "",
  "redact_secrets": true,
  "checkpoints": true,
  "instructions": true,
  "instructions_max_chars": 32000,
  "repo_map": true,
  "repo_map_max_chars": 16000,
  "context_tokens": null,
  "max_num_ctx": null,

  "//connect_timeout": "Seconds to wait for the model endpoint to accept a connection (default 10). Short on purpose: either something is listening on that port or it is not. This is the timeout behind 'Is Ollama running?'.",
  "connect_timeout": 10,
  "//request_timeout": "Seconds to wait for the endpoint to say something once connected (default 600). Long on purpose, and a separate number because it measures SILENCE, not work: a request your endpoint has queued behind another generation sends nothing at all until it starts producing tokens. A flock is the shape that produces that wait — several Worker Birbs against one endpoint — and too small a value here kills workers that had not sent a prompt yet. Raise it if you serve very large models or run many workers at once.",
  "request_timeout": 600,

  "plan_mode": false,
  "audit_log": false,

  "//hooks": "Your own commands at CoBirb's decision points. Events: before_tool, after_tool, before_turn, after_turn. The event arrives as JSON on stdin. A non-zero exit from a before_tool hook BLOCKS the call and its output becomes the reason the model is given. See 'cobirb help hooks'.",
  "hooks": {
    "before_tool": [
      { "match": "write_file", "command": "~/.cobirb/hooks/guard-infra.sh" }
    ],
    "after_turn": [
      "notify-send 'CoBirb finished'"
    ]
  },

  "//mcp_servers": "Local MCP servers, spoken to over stdio. Each one is a program you are choosing to run and to show your work to — see 'cobirb help mcp' before adding one. The environment is NOT inherited: a server gets PATH, HOME, LANG and whatever you list under 'env'.",
  "mcp_servers": {
    "notes": {
      "command": "python3",
      "args": ["/home/you/.cobirb/mcp/notes_server.py"],
      "env": {},
      "inherit_env": false,
      "timeout": 120,
      "enabled": true
    }
  }
}
