/* Layout for CoBirb's interactive mode (see tui/app.py).
   Deliberately restrained: the transcript is Rich panels built by
   plugins/core/render.py, and the chrome around them should frame that
   content rather than compete with it. */

#transcript {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

/* Hidden (display: none, set in code) until tokens actually arrive, so an
   empty preview never eats a row of transcript. */
#streaming-preview {
    height: auto;
    max-height: 12;
    padding: 0 1;
    background: $surface;
}

/* The boxed input from the design: a bordered container wrapping a
   border-less Input, so the box is the frame and the widget inside it
   doesn't draw a second one. */
/* Both grow with the text: the box is the input plus its border, and the
   input sets its own height from the wrapped line count (see PromptInput). */
#prompt-box {
    height: auto;
    max-height: 10;
    border: round $accent;
    background: $surface;
}

#prompt-input {
    border: none;
    height: 1;
    max-height: 8;
    padding: 0 1;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#prompt-input:disabled {
    color: $text-disabled;
}

/* The two bottom rows, docked together (see compose()): the live status line
   above Textual's key-binding Footer. */
#footer-bar {
    dock: bottom;
    height: 2;
}

/* model · plan mode · cwd, kept current for the whole session. */
StatusBar {
    height: 1;
    padding: 0 1;
    background: $panel;
    /* One line, however narrow the terminal: a status bar that wraps would
       push the key-binding row off the bottom of the screen. */
    text-overflow: ellipsis;
}

/* Plugins tab (tui/panes.py::PluginsPane) */
PluginsPane {
    height: 1fr;
}

#plugins-log {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

#plugins-actions {
    height: auto;
    padding: 1;
}

/* Sessions tab (tui/panes.py::SessionsPane) */
SessionsPane {
    height: 1fr;
}

#sessions-active {
    height: auto;
    padding: 1 1 0 1;
}

#sessions-list {
    height: 1fr;
    margin: 1;
}

#sessions-actions {
    height: auto;
    padding: 0 1;
}

#sessions-actions Button {
    margin-right: 1;
}

#sessions-status {
    height: auto;
    padding: 0 1 1 1;
    color: $text-muted;
}

ApprovalModal {
    align: center middle;
}

#approval-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#approval-buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: center;
}

#approval-buttons Button {
    margin: 0 1;
}

HelpModal {
    align: center middle;
}

#help-dialog {
    width: 86;
    max-width: 95%;
    height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

/* Matches ModelPickerModal and any other PickerModal: Textual's type
   selectors match base class names too, and every picker is the same
   dialog with a different title. */
PickerModal {
    align: center middle;
}

#model-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#model-title {
    padding-bottom: 1;
    text-style: bold;
}

#model-options {
    height: auto;
    max-height: 20;
}

ChoiceModal {
    align: center middle;
}

#choice-dialog {
    width: 90;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#choice-question {
    padding-bottom: 1;
}

#choice-detail {
    height: auto;
    max-height: 20;
    padding-bottom: 1;
}

#choice-options {
    height: auto;
}

TextPromptModal {
    align: center middle;
}

#prompt-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#prompt-title {
    text-style: bold;
}

#prompt-label {
    padding-bottom: 1;
    color: $text-muted;
}

#prompt-buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: center;
}

#prompt-buttons Button {
    margin: 0 1;
}

/* The @path picker: five rows at most, sitting just above the prompt box. */
#mention-picker {
    height: auto;
    max-height: 5;
    padding: 0 1;
    margin: 0 1;
    background: $panel;
    color: $text;
}

/* The /command picker: the same five rows, plus one line for the "5 of 18"
   counter that says how many did not fit.

   One row must stay one line. These rows carry a description as well as a
   name, so on a narrow terminal a wrapped row would take two lines, push the
   rows below it past max-height, and silently cost the reader a command —
   worse than a description that trails off in an ellipsis. */
#command-picker {
    height: auto;
    max-height: 6;
    padding: 0 1;
    margin: 0 1;
    background: $panel;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

MemoryCataloguesModal, RememberModal, NewCatalogueModal {
    align: center middle;
}

#memory-dialog, #remember-dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#new-catalogue-dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#memory-title, #remember-title, #new-catalogue-title {
    text-style: bold;
}

#memory-hint, #remember-hint, #remember-fact, #new-catalogue-note {
    padding-bottom: 1;
    color: $text-muted;
}

#memory-options, #remember-options {
    height: auto;
    max-height: 16;
}

#memory-error, #new-catalogue-error {
    color: $error;
    height: auto;
}

#memory-buttons, #new-catalogue-buttons {
    height: auto;
    padding-top: 1;
    align-horizontal: center;
}

#memory-buttons Button, #new-catalogue-buttons Button {
    margin: 0 1;
}

#new-catalogue-name-label, #new-catalogue-password-label, #new-catalogue-confirm-label {
    color: $text-muted;
}

/* ---------------------------------------------------------------- */
/* The Flock tab: one column per Worker Birb.                        */
/* ---------------------------------------------------------------- */
FlockPane {
    height: 1fr;
}

#flock-status {
    height: auto;
    padding: 1 1 0 1;
}

/* Brainy Birb's working-out while it plans, above the (still empty) worker
   row. Removed the moment a charter exists, so it never competes with the
   panes for the tab. */
#brainy-status {
    height: auto;
    padding: 1 2;
    margin: 0 1;
    background: $panel;
    color: $text;
}

#flock-workers {
    height: 1fr;
    padding: 1;
    overflow-x: auto;
    overflow-y: hidden;
}

/* A fixed readable width rather than an equal share of whatever is left:
   three agents at 1fr each squeeze the text past reading, and a pane too
   narrow to read is the same as no pane. The row scrolls sideways instead.
   Widened from 44 to 90: at 44 a worker's tool calls, shortcoming report and
   review all wrapped to shreds, and a pane now also holds that worker's
   approval requests, which have to be read carefully rather than skimmed. */
.worker-pane {
    width: 90;
    height: 1fr;
    margin: 0 1 0 0;
    border: round $primary-darken-2;
    padding: 0 1;
}

/* A request this worker is waiting on, above its log so it cannot scroll out
   of sight. Bordered in $warning and given the pane's full width: it is the
   only thing on this screen where a misread costs something, so it has to be
   unmissable and unambiguous about which column it belongs to. */
.worker-request {
    height: auto;
    max-height: 100%;
    margin-bottom: 1;
    padding: 0 1;
    border: round $warning;
    background: $surface;
}

/* The body and the instruction field scroll; the buttons are docked below
   them. A request as tall as a script sent on stdin used to push its own
   buttons off the bottom of the pane, out of reach. */
.worker-request-scroll {
    height: auto;
    max-height: 100%;
}

.worker-request-body {
    height: auto;
}

.worker-request-instruction {
    margin-top: 1;
    border: round $primary-darken-2;
    background: $surface;
}

.worker-request-buttons {
    dock: bottom;
    height: auto;
    padding-top: 1;
    align-horizontal: center;
}

.worker-request-buttons Button {
    margin: 0 1;
    min-width: 12;
}

.worker-title {
    height: auto;
}

/* The scope is the whole of a worker's isolation, so it stays on screen
   rather than scrolling away with the log — a person watching should be
   able to see what a pane is allowed to touch at any moment. */
.worker-scope {
    height: auto;
    color: $text-muted;
    padding-bottom: 1;
}

.worker-log {
    height: 1fr;
    background: transparent;
}

ConfirmModal {
    align: center middle;
}

#confirm-box {
    width: 76;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#confirm-detail {
    height: auto;
    padding-top: 1;
    color: $text-muted;
}

#confirm-actions {
    height: auto;
    padding-top: 1;
    align-horizontal: center;
}

#confirm-actions Button {
    margin: 0 1;
}

/* The charter approval: most of the screen, because it is read line by line. */
CharterModal {
    align: center middle;
}

#charter-box {
    width: 85%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#charter-body {
    height: auto;
    max-height: 70vh;
    margin-top: 1;
}

/* One line, above the status bar, only present while something is running. */
#activity-bar {
    height: auto;
    padding: 0 1;
    background: $surface;
}
